# Copy this file to .env and fill in what you have.
# The server reads .env from the repo root, whichever directory it starts in.
# .env is gitignored; this example is the only env file that gets committed.
#
# GITHUB_TOKEN can stay empty if `gh` is installed and authenticated: the server
# falls back to `gh auth token`.
# LINEAR_API_KEY has no fallback. Leave it empty and the Linear panel stays blank.
GITHUB_TOKEN=
LINEAR_API_KEY=
